# Python bytecode caches (were tracked by mistake; root-owned copies from
# sudo/kathara runs blocked `git pull`). Never track these.
__pycache__/
*.pyc
*.pyo

# Ephemeral test scaffolding written by test_kathara.sh / krun()
shared/_krun_*.sh
shared/_stats_*.py

# Office temp/lock files
~$*
*.tmp

# Host kernel headers bind-mounted into the Kathara nodes (shared/ is the mount).
# ~114 MB / 17.5k generated files, pinned to one exact kernel version: a build
# dependency of the host, not project source. Regenerate with:
#     bash shared/fetch_host_headers.sh
shared/host_headers/
