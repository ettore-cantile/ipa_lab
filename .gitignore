# Python bytecode caches (were tracked by mistake; root-owned copies from
# sudo runs blocked `git pull`). Never track these.
__pycache__/
*.pyc
*.pyo

# Office temp/lock files (Word/PowerPoint ~$*, LibreOffice .~lock.*#)
~$*
.~lock.*#
*.tmp

# Generated AOT artefacts: gen_full_c.py writes the C source and the header,
# `make` (in ipa/poc_aot/) regenerates them when missing and builds the rest.
ipa/poc_aot/nn_aot_arch.bpf.c
ipa/poc_aot/nn_aot_meta.h
ipa/poc_aot/nn_aot_arch.o
ipa/poc_aot/loader_aot

# Generated synthetic scenarios. `make_scenario.py --preset all` rewrites every
# one of these byte-identically (seed 20260916); test_synth.py generates its own
# into temp dirs and never reads this tree. 42 files / 4.4 MB of pure output.
ipa/synth/scenarios/
ipa/synth/traffic/

# LaTeX build artefacts. The .tex is the source and the .pdf is tracked (it is
# what gets read); everything pdflatex writes in between is regenerable by
# running it again, and .aux/.out churn on every compile.
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc

# results/ keeps one folder per measurement campaign (remeasure_campagna.sh):
# the CSV files and the campaign summary (sintesi.md). Plots, logs and reports
# are regenerated from the CSVs (bench_scaling.py --plot, plot_bitrate.py,
# campaign_report.py); the plots the docs use live in docs/figures/.
results/**/*
!results/**/
!results/**/*.csv
!results/**/sintesi.md
